.env
# Relay data files, written next to server.js whenever DATA_DIR is unset
# (the documented local-run command). subscriptions.json holds push endpoints
# and their p256dh/auth keys -- credential-shaped, never commit it.
server/messages.json
server/subscriptions.json
server/care-events.json
# left behind if a write is interrupted (see writeJsonAtomic)
server/*.json.tmp
coverage

# Capacitor OTA release asset, built from dist/ and uploaded to the
# matching GitHub release rather than committed -- see CLAUDE.md's
# "Releases" section.
bundle.zip

